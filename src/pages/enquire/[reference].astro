---
import SiteLayout from "@/layouts/SiteLayout.astro";
import EnquiryView from "@/components/EnquiryView.astro";
import { getProducts } from "@/lib/products";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { reference: product.data.reference.toLowerCase() },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<SiteLayout
  title={`Enquire about ${product.data.title}`}
  description={`Enquire about ${product.data.title}, ${product.data.reference}. No payment is taken online.`}
>
  <EnquiryView product={product} />
</SiteLayout>
