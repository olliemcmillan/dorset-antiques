---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/Section.astro";
import Row from "@/components/Row.astro";
import Col from "@/components/Col.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import PieceCard from "@/components/PieceCard.astro";
import { render } from "astro:content";
import {
  availabilityLabel,
  categoryLabel,
  deliveryNote,
  getProducts,
  productSrc,
  relatedProducts,
} from "@/lib/products";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const related = relatedProducts(await getProducts(), product.id);
const enquiryHref = `/enquire/${product.data.reference.toLowerCase()}`;
const { data } = product;
---

<SiteLayout title={data.title} description={data.description}>
  <Section class="block">
    <p class="breadcrumb">
      <a href="/collection">Collection</a>
      <span aria-hidden="true"> / </span>
      <a href={`/collection/${data.category}`}>
        {categoryLabel(data.category)}
      </a>
      <span aria-hidden="true"> / </span>
      <span>{data.title}</span>
    </p>
    <div class="piece-layout">
      <div class="piece-gallery">
        <img
          class="piece-gallery_main"
          src={productSrc(data.gallery[0].image)}
          alt={data.gallery[0].alt}
          fetchpriority="high"
        />
        {
          data.gallery.length > 1 && (
            <div class="piece-gallery_details">
              {data.gallery.slice(1).map((image) => (
                <div class="piece-gallery_detail">
                  <img src={productSrc(image.image)} alt={image.alt} />
                </div>
              ))}
            </div>
          )
        }
        {
          data.galleryCaption && (
            <div class="gallery-caption">
              <p>{data.galleryCaption}</p>
              <p>{data.gallery.length} photographs</p>
            </div>
          )
        }
      </div>
      <div data-title-reveal>
        <p class="eyebrow">
          {categoryLabel(data.category)} / {data.reference}
        </p>
        <h1 class="piece-title">{data.title}</h1>
        <p class="piece-summary">{data.summary}</p>
        <p class:list={["availability", `cc-${data.availability}`]}>
          <span class="availability_marker" aria-hidden="true"></span>
          {availabilityLabel[data.availability]}
        </p>
        <hr class="hairline" />
        <p class="piece-price">Price on enquiry</p>
        <div class="rich-text muted stack">
          <Content />
        </div>
        <div class="stack-lg">
          <Button href={enquiryHref} full>
            Enquire about this piece
            <Icon name="arrow-right" />
          </Button>
        </div>
        <p class="form-note stack">
          Ask for the price, further photographs or a detailed condition report.
          No payment is taken online.
        </p>
        <dl class="piece-facts">
          {
            data.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="note-block" data-title-reveal>
      <p class="eyebrow">Condition & character</p>
      <p class="muted">{data.condition}</p>
    </div>
    <div class="note-block" data-title-reveal>
      <p class="eyebrow">Delivery & collection</p>
      <p class="muted">{deliveryNote}</p>
    </div>

    {
      data.history && (
        <div class="note-block history-intro">
          <div data-title-reveal>
          <p class="eyebrow">Illustrative sample history</p>
          <h2>A sample timeline of the piece</h2>
          <p class="muted">
            This is a narrative interpretation of the object’s journey. Verified
            provenance was not supplied for {data.reference}, so the timeline
            below is illustrative rather than documented fact. It is intended to
            evoke the kind of story an object like this might carry.
          </p>
          </div>
          <div class="timeline">
            {data.history.map((moment, index) => (
              <article class="timeline_row">
                <div class="timeline_mark" aria-hidden="true">
                  <span class="timeline_dot" />
                  {index < data.history!.length - 1 && (
                    <span class="timeline_line" />
                  )}
                </div>
                <div>
                  <p class="eyebrow timeline_when">{moment.when}</p>
                  <h3 class="h4">{moment.title}</h3>
                  <p class="muted">{moment.body}</p>
                  {index === data.history!.length - 1 && (
                    <div class="stack-sm">
                      <Button href={enquiryHref} full>
                        Enquire about becoming the next custodian
                        <Icon name="arrow-right" />
                      </Button>
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      )
    }
  </Section>

  <Section class="block">
    <h2 class="h3">You may also be drawn to…</h2>
    <Row gap="md">
      {
        related.map((item) => (
          <Col lg={4} md={6} xs={12}>
            <PieceCard product={item} />
          </Col>
        ))
      }
    </Row>
  </Section>
</SiteLayout>
