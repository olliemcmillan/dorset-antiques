---
import {
  availabilityLabel,
  categoryLabel,
  productSrc,
  type Product,
} from "@/lib/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { data } = product;
---

<a class="piece-card" href={`/pieces/${product.id}`}>
  <span class="piece-card_media">
    <img src={productSrc(data.image)} alt={data.imageAlt} loading="lazy" />
  </span>
  <span class="piece-card_body">
    <span class="eyebrow">
      {categoryLabel(data.category)} / {data.reference}
    </span>
    <span class="piece-card_title">{data.title}</span>
    <span class="piece-card_summary">{data.summary}</span>
    <span class="piece-card_meta">
      <span>Price on enquiry</span>
      <span class="piece-card_sep" aria-hidden="true">/</span>
      <span class:list={["availability", `cc-${data.availability}`]}>
        <span class="availability_marker" aria-hidden="true"></span>
        {availabilityLabel[data.availability]}
      </span>
    </span>
  </span>
</a>
