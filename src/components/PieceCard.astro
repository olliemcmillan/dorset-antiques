---
import { availabilityLabel, categoryLabel, type Piece } from "@/data/catalogue";

interface Props {
  piece: Piece;
}

const { piece } = Astro.props;
---

<a class="piece-card" href={`/pieces/${piece.slug}`}>
  <span class="piece-card_media">
    <img src={piece.image} alt={piece.imageAlt} loading="lazy" />
  </span>
  <span class="piece-card_body">
    <span class="eyebrow">
      {categoryLabel(piece.category)} / {piece.reference}
    </span>
    <span class="piece-card_title">{piece.title}</span>
    <span class="piece-card_summary">{piece.summary}</span>
    <span class="piece-card_meta">
      <span>Price on enquiry</span>
      <span class="piece-card_sep" aria-hidden="true">/</span>
      <span class:list={["availability", `cc-${piece.availability}`]}>
        <span class="availability_marker" aria-hidden="true"></span>
        {availabilityLabel[piece.availability]}
      </span>
    </span>
  </span>
</a>
