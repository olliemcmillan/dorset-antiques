---
import Wordmark from "@/components/Wordmark.astro";
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer_top">
      <a href="/" class="site-footer_logo" aria-label="Dorset Antiques, home">
        <Wordmark />
      </a>
      <div class="site-footer_statement">
        <p>Glassware, fine art and furniture.</p>
        <p>Considered pieces, individual enquiries.</p>
        <p class="site-footer_domain">dorsetantiques.co.uk</p>
      </div>
      <nav class="site-footer_links" aria-label="Footer">
        <a href="/collection">Collection</a>
        <a href="/#approach">Our approach</a>
        <a href="/notes">Collecting notes</a>
        <a href="/enquire">Enquiries</a>
      </nav>
    </div>
    <div class="site-footer_rule"></div>
    <div class="site-footer_legal">
      <p>© Dorset Antiques</p>
      <p>
        <a href="/privacy">Privacy & cookies</a>
        <span aria-hidden="true"> · </span>
        <a href="/terms">Terms of enquiry</a>
      </p>
    </div>
  </div>
</footer>
